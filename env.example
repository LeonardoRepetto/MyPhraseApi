# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Security
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRE=30d
API_KEY=myphraseapi-secret-key-2024

# Database (for future use)
# DATABASE_URL=mongodb://localhost:27017/myphraseapi
# DATABASE_NAME=myphraseapi

# Firebase Configuration
FCM_SERVER_KEY=your-fcm-server-key
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/firebase-credentials.json

# API Keys (for future external services)
# OPENAI_API_KEY=your-openai-api-key
# TWILIO_API_KEY=your-twilio-api-key 